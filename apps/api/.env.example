PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qyou?schema=public"

# Secret used to sign access tokens. Use a long, random value in production.
JWT_SECRET="dev-secret-change-me"

# Access token lifetime (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN="1h"

# bcrypt cost factor (salt rounds); must be >= 12. Higher = stronger, slower.
BCRYPT_SALT_ROUNDS="12"

# How long a session counts as "recent" for destructive actions such as
# DELETE /wallet (#1154). Outside this window the caller must re-enter the
# account password.
WALLET_UNLINK_REAUTH_MINUTES="10"
